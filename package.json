{
  "name": "beacon-indexer",
  "description": "Beacon chain indexer and API for collecting and exposing Ethereum beacon chain validator data",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "author": {
    "name": "Domínguez Nicolás",
    "email": "nf.dominguez.87@gmail.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/NodeSentinel/beacon-indexer.git"
  },
  "homepage": "https://github.com/NodeSentinel/beacon-indexer#readme",
  "website": "https://node-sentinel.xyz",
  "bugs": {
    "url": "https://github.com/NodeSentinel/beacon-indexer/issues"
  },
  "keywords": [
    "gnosis chain",
    "ethereum",
    "beacon chain",
    "beacon-chain",
    "validator",
    "indexer",
    "blockchain",
    "consensus",
    "staking"
  ],
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.2.0",
  "scripts": {
    "test": "pnpm -r run test",
    "test:scripts": "node --test scripts/*.test.js",
    "test:e2e:local": "node scripts/run-e2e-local.js",
    "test:e2e:indexer": "node scripts/run-e2e-local.js indexer",
    "test:e2e:api": "node scripts/run-e2e-local.js api",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "type-check:webapp": "pnpm --filter @beacon-indexer/api build && pnpm --filter @beacon-indexer/webapp exec tsc --noEmit",
    "type-check:docker": "pnpm --filter @beacon-indexer/beacon-utils exec tsc --noEmit && pnpm --filter @beacon-indexer/db exec tsc --noEmit && pnpm --filter @beacon-indexer/api exec tsc --noEmit && pnpm --filter indexer exec tsc --noEmit && pnpm --filter telegram-bot exec tsc --noEmit",
    "type-check": "pnpm run type-check:webapp && pnpm run type-check:docker",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "build": "pnpm --filter @beacon-indexer/db build && pnpm --filter indexer build",
    "build:api": "pnpm --filter @beacon-indexer/api build",
    "build:app": "pnpm --filter @beacon-indexer/api build && pnpm --filter @beacon-indexer/webapp build",
    "logs:errors": "tail -250 packages/indexer/logs/errors-latest.log",
    "logs": "tail -250 packages/indexer/logs/latest.log",
    "host:indexer": "node scripts/dev-service.js indexer",
    "host:api": "node scripts/dev-service.js api",
    "host:webapp": "node scripts/dev-service.js webapp",
    "host:app": "node scripts/dev-service.js webapp",
    "host:bot": "node scripts/dev-service.js bot",
    "docker:up": "node scripts/docker-env.js",
    "docker:up:prod": "node scripts/docker-env.js --env=prod",
    "docker:up:prod:gnosis": "node scripts/docker-env.js --chain=gnosis --env=prod --all",
    "docker:up:prod:ethereum": "node scripts/docker-env.js --chain=ethereum --env=prod --all",
    "docker:up:dev": "node scripts/docker-env.js --env=dev",
    "docker:up:dev:gnosis": "node scripts/docker-env.js --chain=gnosis --env=dev",
    "docker:up:dev:ethereum": "node scripts/docker-env.js --chain=ethereum --env=dev",
    "docker:down": "node scripts/docker-env.js --down",
    "prisma:studio": "node scripts/prisma-env.js db:studio",
    "prisma:deploy": "node scripts/prisma-env.js db:deploy",
    "prisma:generate": "pnpm --filter @beacon-indexer/db prisma:generate && pnpm --filter @beacon-indexer/db build",
    "prisma:migrate": "node scripts/prisma-env.js db:migrate",
    "prisma:push": "node scripts/prisma-env.js db:push",
    "prepare": "husky"
  },
  "dependencies": {
    "@beacon-indexer/db": "workspace:*",
    "@prisma/client": "6.16.2",
    "prisma": "6.16.2"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.64.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.27.0",
    "@t3-oss/env-core": "^0.9.2",
    "@types/node": "^22.17.2",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "pnpm": "^9.2.0",
    "prettier": "^3.2.5",
    "prettier-linter-helpers": "^1.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.5.0"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,cjs,mjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ],
    "packages/db/**/*.{ts,tsx}": [
      "bash -c 'cd packages/db && pnpm exec tsc --noEmit'"
    ],
    "packages/indexer/**/*.{ts,tsx}": [
      "bash -c 'cd packages/indexer && pnpm exec tsc --noEmit'"
    ],
    "packages/telegram-bot/**/*.ts": [
      "bash -c 'cd packages/telegram-bot && pnpm exec tsc --noEmit'"
    ],
    "packages/api/**/*.{ts,tsx}": [
      "bash -c 'cd packages/api && pnpm exec tsc --noEmit'"
    ],
    "packages/webapp/**/*.{ts,tsx}": [
      "bash -c 'pnpm --filter @beacon-indexer/api build && pnpm --filter @beacon-indexer/webapp exec tsc --noEmit'"
    ]
  },
  "pnpm": {
    "overrides": {
      "pnpm@<10.0.0": ">=10.0.0",
      "next@>=13.0 <14.2.30": ">=14.2.30",
      "next@>=0.9.9 <14.2.31": ">=14.2.31",
      "next@>=0.9.9 <14.2.32": ">=14.2.32",
      "next@=14.2.25": ">=14.2.26",
      "vite@>=7.1.0 <=7.1.10": ">=7.1.11",
      "js-yaml@>=4.0.0 <4.1.1": ">=4.1.1",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "valibot@>=0.31.0 <1.2.0": ">=1.2.0"
    }
  }
}
