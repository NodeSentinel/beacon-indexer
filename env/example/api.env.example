# API runtime configuration.

NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000

CHAIN=gnosis
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public
NATIVE_TOKEN_DECIMALS=18
CONSENSUS_LOOKBACK_SLOT=0

API_TOKEN_SECRET=change-me-minimum-32-characters-long

TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=604800

COINGECKO_TOKEN_PRICE_API_URL=https://api.coingecko.com/api/v3/simple/price
COINGECKO_TOKEN_NAME=gnosis
