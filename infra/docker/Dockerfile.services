# syntax=docker/dockerfile:1.7

# Use one shared Node base so every service build starts from the same cache.
FROM node:22-alpine AS base

# Install the native packages required by Prisma and timezone-aware runtimes.
RUN apk add --no-cache openssl tzdata

# Pin pnpm to the repo version so every target resolves the workspace the same way.
RUN npm install -g pnpm@9.2.0

WORKDIR /app

# Skip Prisma postinstall generation until the schema is present in the image.
ENV PRISMA_SKIP_POSTINSTALL_GENERATE=true

# Copy only workspace metadata first so dependency installation stays reusable.
FROM base AS deps
# root
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
# db
COPY packages/db/package.json ./packages/db/package.json
COPY packages/db/tsconfig.json ./packages/db/tsconfig.json
COPY packages/db/prisma ./packages/db/prisma
# beacon-utils
COPY packages/beacon-utils/package.json ./packages/beacon-utils/package.json
COPY packages/beacon-utils/tsconfig.json ./packages/beacon-utils/tsconfig.json
# api
COPY packages/api/package.json ./packages/api/package.json
COPY packages/api/tsconfig.json ./packages/api/tsconfig.json
# indexer
COPY packages/indexer/package.json ./packages/indexer/package.json
COPY packages/indexer/tsconfig.json ./packages/indexer/tsconfig.json
# telegram-bot
COPY packages/telegram-bot/package.json ./packages/telegram-bot/package.json
COPY packages/telegram-bot/tsconfig.json ./packages/telegram-bot/tsconfig.json

# Install the workspace once so every service target can share the same layer.
RUN pnpm install --frozen-lockfile

# Copy only Prisma inputs first so service source changes do not invalidate Prisma generation.
FROM deps AS prisma

RUN pnpm exec prisma generate --schema=./packages/db/prisma/schema.prisma

# Copy only db sources before building the shared db package.
FROM prisma AS db-build

COPY packages/db/src ./packages/db/src
RUN pnpm --filter @beacon-indexer/db run build

# Keep the migrate target light because it only needs Prisma CLI and the schema.
FROM prisma AS migrate

WORKDIR /app

# Reuse the shared db build for the api runtime image.
FROM db-build AS api

COPY packages/beacon-utils ./packages/beacon-utils
COPY packages/api ./packages/api
WORKDIR /app/packages/api
CMD ["pnpm", "run", "start"]

# Reuse the shared db build for the indexer runtime image.
FROM db-build AS indexer

COPY packages/beacon-utils ./packages/beacon-utils
COPY packages/indexer ./packages/indexer
WORKDIR /app/packages/indexer
CMD ["pnpm", "run", "start"]

# Reuse the shared db build for the bot runtime image.
FROM db-build AS bot

COPY packages/beacon-utils ./packages/beacon-utils
COPY packages/api ./packages/api
COPY packages/telegram-bot ./packages/telegram-bot
WORKDIR /app/packages/telegram-bot
CMD ["pnpm", "run", "start"]
