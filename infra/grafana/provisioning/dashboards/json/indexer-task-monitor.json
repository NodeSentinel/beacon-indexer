{
  "uid": "indexer-task-monitor",
  "title": "Indexer Task Monitor",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "epoch",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({app=\"beacon-chain-validators-monitor\", job=\"indexer-task-monitor\"}, epoch)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "slot",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({app=\"beacon-chain-validators-monitor\", job=\"indexer-task-monitor\", epoch=~\"$epoch\"}, slot)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "task",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({app=\"beacon-chain-validators-monitor\", job=\"indexer-task-monitor\", epoch=~\"$epoch\", slot=~\"$slot\"}, task)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 24,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "started"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 48
              },
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "●": {
                        "color": "yellow",
                        "index": 0,
                        "text": "●"
                      },
                      "✓": {
                        "color": "green",
                        "index": 1,
                        "text": "✓"
                      },
                      "✕": {
                        "color": "red",
                        "index": 2,
                        "text": "✕"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "total"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 86
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "avg"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 86
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "delta"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 86
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^\\+",
                      "result": {
                        "color": "red",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^-",
                      "result": {
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "replace": true
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "actorId": true,
              "epoch": true,
              "errorMessage": true,
              "reportedAt": true,
              "slot": true,
              "status": true,
              "task": true
            },
            "indexByName": {
              "started": 0,
              "statusIcon": 1,
              "taskPath": 2,
              "totalDisplay": 3,
              "avgDisplay": 4,
              "deltaDisplay": 5
            },
            "renameByName": {
              "avgDisplay": "avg",
              "deltaDisplay": "delta",
              "started": "started",
              "statusIcon": "status",
              "taskPath": "task",
              "totalDisplay": "total"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"beacon-chain-validators-monitor\", job=\"indexer-task-monitor\", epoch=~\"$epoch\", slot=~\"$slot\", task=~\"$task\"}",
          "queryType": "range"
        }
      ]
    }
  ]
}
