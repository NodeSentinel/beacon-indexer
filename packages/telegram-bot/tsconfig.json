{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@beacon-indexer/api/routers": ["../api/src/routers/index.ts"],
      "@/*": ["*", "../api/src/*"]
    },
    "noEmit": true,
    "outDir": "build",
    "sourceMap": true,
    "skipLibCheck": true,
    "preserveWatchOutput": true
  },
  "include": ["src/**/*"]
}
