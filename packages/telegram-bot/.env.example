# Telegram bot
BOT_TOKEN=

# Bot runtime mode.
BOT_MODE=polling # | webhook
BOT_RATE_LIMIT_PER_SECOND=30
# These values only matter when BOT_MODE=webhook.
SERVER_HOST=0.0.0.0
SERVER_PORT=3001
BOT_WEBHOOK=https://bot.example.com/webhook
BOT_WEBHOOK_SECRET=replace-with-a-long-random-secret

# API connection
API_URL=http://api:3000

# Chain configuration
CHAIN=gnosis

# Logging
# DEBUG=true enables verbose request logging in webhook mode.
LOG_LEVEL=info
DEBUG=false

# Bot admins
BOT_ADMINS=[1]
