FROM node:22-alpine

# Install system dependencies for Prisma, then pnpm for workspace installs.
RUN apk add --no-cache openssl
RUN npm install -g pnpm@9.2.0

WORKDIR /app

# Copy only the package metadata needed to install Prisma and the db workspace package.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/db/package.json ./packages/db/package.json
COPY packages/db/tsconfig.json ./packages/db/tsconfig.json
COPY packages/db/prisma ./packages/db/prisma

# Skip Prisma's postinstall generation so the image stays focused on migration runtime only.
ENV PRISMA_SKIP_POSTINSTALL_GENERATE=true
RUN pnpm install --frozen-lockfile
