# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_LEVEL=info

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DATABASE_URL=postgresql://beacon_user:beacon_password@localhost:5432/beacon_dev?schema=public

# ===========================================
# BLOCKCHAIN CONFIGURATION
# ===========================================
CHAIN=gnosis # ethereum or gnosis

CONSENSUS_LOOKBACK_SLOT=26380272 # slot number from where to start indexing
CONSENSUS_ARCHIVE_API_URL=https://...
CONSENSUS_ARCHIVE_API_TOKEN=httpHeader:httpHeaderValue
CONSENSUS_FULL_API_URL=https://...
CONSENSUS_API_REQUEST_PER_SECOND=20

EXECUTION_BLOCKSCOUT_URL=https://eth.blockscout.com
EXECUTION_BLOCKSCOUT_KEY=
EXECUTION_ETHERSCAN_URL=https://api.etherscan.io
EXECUTION_ETHERSCAN_KEY=
EXECUTION_QUICKNODE_URL=
EXECUTION_QUICKNODE_KEY=
EXECUTION_API_REQUEST_PER_SECOND=3

# ===========================================
# TG ALERTING - SYSTEM DOWN
# ===========================================
TELEGRAM_ALERTS_BOT_TOKEN=
TELEGRAM_ALERTS_CHAT_ID=